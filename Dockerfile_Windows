FROM python:3.11-windowsservercore-1809

ENV HOME=C:/home/app
#RUN mkdir $HOME
WORKDIR $HOME
COPY BICDIR2018_V1_FULL_20231229.txt \
     db_init.py \
     email_template.html\
     mail.py \
     PdfReader.py \
     requirements.txt \
     template.html \
     .env $HOME/
COPY static/ $HOME/static/
USER ContainerAdministrator


SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]


RUN [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $installer = Join-Path $env:TEMP 'vc_redist.x64.exe'; Invoke-WebRequest 'https://aka.ms/vs/17/release/vc_redist.x64.exe' -OutFile $installer; if (!(Test-Path $installer)) { throw 'VC++ installer download failed' }; $process = Start-Process -FilePath $installer -ArgumentList '/install', '/quiet', '/norestart' -Wait -PassThru; if ($process.ExitCode -ne 0 -and $process.ExitCode -ne 3010) { throw "VC++ installation failed with exit code $($process.ExitCode)" }; Remove-Item -Force $installer
ARG GTK_VERSION=2026.10.0

ENV GTK_HOME=C:\GTK
ENV WEASYPRINT_DLL_DIRECTORIES=C:\GTK\bin

# GTK runtime version
ARG GTK_VERSION=2026.10.0

ENV GTK_HOME=C:\GTK
ENV WEASYPRINT_DLL_DIRECTORIES=C:\GTK\bin

# Download and extract GTK runtime
RUN Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/wingtk/gvsbuild/releases/download/2026.10.0/GTK4_Gvsbuild_2026.10.0_x64.zip' -OutFile 'C:\gtk.zip'; if (!(Test-Path 'C:\gtk.zip')) { throw 'GTK download failed' }; Expand-Archive -Path 'C:\gtk.zip' -DestinationPath 'C:\GTK' -Force; Remove-Item 'C:\gtk.zip' -Force


RUN python -m pip install --upgrade pip
RUN python -m pip install -r requirements.txt



CMD ["python","PdfReader.py"]