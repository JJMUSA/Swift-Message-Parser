SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]


# =====================================================
# GTK / PANGO NATIVE DEPENDENCIES
# =====================================================

ARG GTK_VERSION=2026.10.0

ENV GTK_HOME=C:\GTK
ENV WEASYPRINT_DLL_DIRECTORIES=C:\GTK\bin

ARG GTK_VERSION=2026.10.0

ENV GTK_HOME=C:\GTK
ENV WEASYPRINT_DLL_DIRECTORIES=C:\GTK\bin


RUN $version='2026.10.0'; $url="https://github.com/wingtk/gvsbuild/releases/download/$version/GTK4_Gvsbuild_${version}_x64.zip"; Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile "$env:TEMP\gtk.zip"; if (!(Test-Path "$env:TEMP\gtk.zip")) { throw 'GTK download failed' }; Expand-Archive -Path "$env:TEMP\gtk.zip" -DestinationPath 'C:\GTK' -Force; Remove-Item "$env:TEMP\gtk.zip" -Force


ENV PATH=C:\GTK\bin;C:\Python311;C:\Python311\Scripts;%PATH%


RUN $required=@('libgobject-2.0-0.dll','libglib-2.0-0.dll','libpango-1.0-0.dll','libcairo-2.dll'); foreach ($dll in $required) { if (!(Test-Path "C:\GTK\bin\$dll")) { throw "Missing GTK dependency: $dll" } }


ENV WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin
RUN C:\Python\python.exe -m pip install --upgrade pip
RUN pip install -r requirements.txt

RUN python -c "from weasyprint import HTML; HTML(string='<h1>WeasyPrint Docker Test</h1>').write_pdf(r'C:\home\app\test.pdf')"

CMD ["python","PdfReader.py"]